<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.attendance</groupId>
    <artifactId>attendance-root</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>attendance-root</name>
    <description>Root parent for Attendance microservices</description>

    <properties>
        <java.version>17</java.version>
        <spring-boot.version>4.0.1</spring-boot.version>

        <!-- Если используешь Spring Cloud (Config, Eureka, Gateway и т.д.) -->
        <!-- Подбери совместимую версию под Boot 4 -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <surefire.useModulePath>false</surefire.useModulePath>
    </properties>

    <!-- Управление версиями зависимостей для всех модулей -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud BOM (если не используешь Cloud — просто удали этот блок) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Список модулей (папки в корне проекта) -->
    <modules>
        <module>common-lib</module>
<!--        <module>api-gateway</module>-->
<!--        <module>auth-service</module>-->
<!--        <module>attendance-service</module>-->
<!--        <module>notification-service</module>-->
        <!-- добавляй свои -->
    </modules>

    <!-- Общие зависимости, которые полезны всем модулям (обычно мало) -->
    <dependencies>
        <!-- Lombok удобно держать тут, а в модулях просто подключать без версии -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <!-- Общие настройки сборки/плагинов для всех модулей -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- Компилятор -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>${maven.compiler.parameters}</parameters>
                    </configuration>
                </plugin>

                <!-- Тесты -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <useModulePath>${surefire.useModulePath}</useModulePath>
                    </configuration>
                </plugin>

                <!-- Интеграционные тесты (если надо) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                </plugin>

                <!-- Spring Boot plugin: будет использоваться только в сервисах, где он подключен -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
